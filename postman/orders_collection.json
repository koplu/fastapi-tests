{
  "info": {
    "name": "FastAPI Orders API Tests",
    "description": "Automated API tests for GET and POST orders endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    }
  ],
  "item": [
    {
      "name": "GET existing order",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/orders/1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Correct order data', function () {",
              "    const data = pm.response.json();",
              "    pm.expect(data.id).to.eql(1);",
              "    pm.expect(data.product).to.eql('T-shirt');",
              "    pm.expect(data.quantity).to.eql(2);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "POST create order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"product\":\"Keyboard\",\"quantity\":1}"
        },
        "url": "{{baseUrl}}/orders"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP status is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test('Created order contains correct data', function () {",
              "    const data = pm.response.json();",
              "    pm.expect(data.id).to.be.a('number');",
              "    pm.expect(data.product).to.eql('Keyboard');",
              "    pm.expect(data.quantity).to.eql(1);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
